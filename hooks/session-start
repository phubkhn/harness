#!/usr/bin/env bash
# SessionStart hook: inject the content of skills/using-gft/SKILL.md into the
# context at the start of the session, so the agent checks
# registry/activation-rules.yaml before acting, instead of guessing which
# skill or agent to use.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

using_gft_content=$(cat "${PLUGIN_ROOT}/skills/using-gft/SKILL.md" 2>&1 || echo "Error reading skills/using-gft/SKILL.md")

# Escape the string so it can be embedded in JSON, using bash parameter
# substitution — each ${s//old/new} runs in one pass at the C level, which
# is much faster than looping over each character.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

using_gft_escaped=$(escape_for_json "$using_gft_content")
session_context="<EXTREMELY_IMPORTANT>\nYou are running inside the GFT Harness.\n\n**Below is the full content of the 'gft:using-gft' skill — how to check the registry to pick an agent/skill before acting. For other skills, use the Skill tool:**\n\n${using_gft_escaped}\n</EXTREMELY_IMPORTANT>"

# Output the injection as JSON. The Claude Code hook needs
# hookSpecificOutput.additionalContext (nested).
#
# Use printf instead of a heredoc, to avoid bash 5.3+ hanging on heredoc.
# Xem: https://github.com/obra/superpowers/issues/571
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat

exit 0
